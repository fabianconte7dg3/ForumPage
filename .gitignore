# Dependencias
node_modules/
.pnpm-store/

# Next.js
.next/
out/
build/
dist/

# Payload — archivos subidos, nunca se versionan.
media/
# `documentos-privados/` con más razón que `media/`: son documentos de becarios
# (socioeconómicos, académicos, evidencia de labor social que puede contener
# menores). Meterlos en git los vuelve legibles para cualquiera con acceso al
# repo y los deja en el historial para siempre, que es justo lo que la
# colección DocumentosPrivados existe para impedir.
documentos-privados/
# fotos-becarios/ es pública condicionalmente (mostrar_en_mapa), pero sigue
# siendo un directorio de subidas — mismo criterio que media/, nunca se versiona.
fotos-becarios/

# Volcado del WordPress viejo, solo de referencia para migrar contenido —
# no es parte de la app, no se versiona (son varios cientos de MB de imágenes).
ForumOldPageInfo/

# Copiado por postinstall desde node_modules/maplibre-gl (ver package.json)
public/maplibre-gl-worker.mjs
public/maplibre-gl-shared.mjs

# Entorno y secretos
.env
.env.*
!.env.example
!.env.staging.example

# Editor / SO
.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

