# Copiar a .env junto a docker-compose.staging.yml y completar en el
# servidor (nunca commitear el .env real). Ver 03-runbook-tecnico.md §0.5 y §12.

# Dominio que sirve Caddy — staging.forum-foundation.org o forum-foundation.org
SITE_DOMAIN=staging.forum-foundation.org

# Postgres (red interna de Docker, sin puertos publicados)
POSTGRES_USER=forum
POSTGRES_PASSWORD=GENERAR_CON_openssl_rand_-base64_24
DATABASE_URI=postgresql://forum:GENERAR_CON_openssl_rand_-base64_24@db:5432/forum

PAYLOAD_SECRET=GENERAR_CON_openssl_rand_-base64_32
NEXT_PUBLIC_SERVER_URL=https://staging.forum-foundation.org

# Opcional: sin esta llave el Mapa de Impacto usa las teselas demo de MapLibre
# (solo contornos de país, sin calles). Con la llave real usa MapTiler.
MAPTILER_KEY=
