{
  "name": "forum-foundation",
  "version": "0.1.0",
  "description": "Plataforma Forum Foundation — Next.js + Payload CMS 3 + PostgreSQL",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:wordpress": "tsx --env-file=.env scripts/migrate-wordpress.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "postinstall": "mkdir -p public && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:nosotros": "tsx --env-file=.env scripts/seed-nosotros.ts",
    "migrate:historias": "tsx --env-file=.env scripts/migrate-all-historias.ts",
    "purgar:media-privada": "tsx --env-file=.env scripts/purgar-media-privada.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "@tailwindcss/postcss": "4.3.3",
    "@turf/great-circle": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "cross-env": "10.1.0",
    "maplibre-gl": "^6.0.0",
    "next": "16.2.12",
    "payload": "3.82.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "^1.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.7",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
